//=====================================================================
// 9. PARÁMETROS DE VISUALIZACIÓN
//=====================================================================

var rgbParams = {
    bands:['B4','B3','B2'],
    min:0.0,
    max:0.3,
    gamma:1.2
};


var ndciParams = {
    min:-0.5,
    max:0.5,
    palette:[

        '08306b',
        '2171b5',
        '6baed6',
        'ffffbf',
        'fdae61',
        'f46d43',
        'a50026'
    ]
};



//=====================================================================
// 10. FUNCIÓN PARA VISUALIZAR UNA FECHA
//=====================================================================
// Para cada fecha se muestran:
// • Imagen RGB corregida mediante SIAC.
// • Imagen NDCI.

function visualizarFecha(fecha){
    var img = s2_boa
        .filterDate(
            ee.Date(fecha),
            ee.Date(fecha).advance(1,'day')
        )
        .first();
    print(
        'Imagen disponible (' + fecha + '):',
        img
    );


    Map.addLayer(
        img.clip(embalse),
        rgbParams,
        'RGB SIAC - ' + fecha
    );


    var ndci = img.normalizedDifference(
        ['B5','B4']
    );


    Map.addLayer(
        ndci.clip(embalse),
        ndciParams,
        'NDCI - ' + fecha
    );

}


//=====================================================================
// 11. VISUALIZAR LAS FECHAS DEFINIDAS
//=====================================================================

fechasViz.forEach(function(fecha){
    visualizarFecha(fecha);
});


Map.addLayer(
    puntos,
    {color:'black'},
    'Puntos de muestreo'
);


